    "NoteStatus": {
      "enum": [
        "confirmed",
        "unverified"
      ],
      "title": "NoteStatus",
      "type": "string"
    },
    "NoteType": {
      "description": "Practice shape, never domain (PLAN 3.4).",
      "enum": [
        "bidirectional",
        "directional"
      ],
      "title": "NoteType",
      "type": "string"
    },
    "Priority": {
      "description": "How often a word should come up, as the person asked for it (PLAN 3.2).\n\nThe ordinary middle is *absent*, not a third member: a collection nobody has\nmarked exports exactly as it did before there was a mark to set. What the\nmark is finally worth is damped by how well the card is already known —\n:mod:`memo.practice.priority`.",
      "enum": [
        "low",
        "high",
        "crucial"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Source": {
      "additionalProperties": true,
      "description": "Provenance. Entirely optional — a hand-made file has none.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "image",
                "pdf",
                "text",
                "json",
                "csv",
                "anki",
                "manual"
