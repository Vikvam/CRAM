{
  "$defs": {
    "Accept": {
      "additionalProperties": true,
      "description": "Answers counted as correct when typed, in addition to the displayed one.\n\nAlways explicit — filled by the extractor or by the \"that's the same thing\"\nbutton during practice, never guessed from punctuation at runtime (PLAN 3.5).",
      "properties": {
        "front": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Front"
        },
        "back": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Back"
        }
      },
      "title": "Accept",
      "type": "object"
    },
